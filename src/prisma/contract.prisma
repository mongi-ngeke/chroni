// use prisma-8
// Contrat de données de Chroni.

enum RunStatus {
  @@type("pg/text@1")
  in_progress = "in_progress"
  won         = "won"
}

// Où se trouve une carte d'un run.
enum RunZone {
  @@type("pg/text@1")
  timeline  = "timeline"
  hand      = "hand"
  draw_pile = "draw_pile"
  discard   = "discard"
}

model Card {
  id          String    @id @onCreate(cuid(2))
  title       String
  year        Int
  category    String?
  // Visibles dès la main : ne doivent jamais contenir la date (voir docs/agent/game-rules.md).
  description String
  imageUrl    String
  imageAlt    String
  imageCredit String
  createdAt   DateTime  @onCreate(now())
  runCards    RunCard[]
}

// Joueur inscrit. L'email est normalisé (minuscules) par le domaine avant d'arriver ici.
model User {
  id           String    @id
  email        String    @unique
  // Empreinte scrypt avec son sel, jamais le mot de passe.
  passwordHash String
  createdAt    DateTime  @onCreate(now())
  sessions     Session[]
  runs         Run[]
}

// Session de connexion. `id` est l'empreinte SHA-256 du jeton du cookie : le jeton lui-même
// n'est jamais stocké.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @onCreate(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Run {
  id        String    @id
  status    RunStatus
  // Absent pour une partie d'invité (accessible par son URL) ; présent, la partie est privée.
  userId    String?
  createdAt DateTime  @onCreate(now())
  updatedAt DateTime  @onCreate(now()) @onUpdate(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     RunCard[]

  @@index([userId])
}

// Une carte dans un run. `position` ordonne la frise, la pioche (0 = dessus) et
// la défausse ; dans la main elle n'a pas de sens métier (le serveur ne connaît pas l'ordre).
model RunCard {
  runId    String
  cardId   String
  zone     RunZone
  position Int
  run      Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  card     Card    @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@id([runId, cardId])
  @@unique([runId, zone, position])
  @@index([cardId])
}
