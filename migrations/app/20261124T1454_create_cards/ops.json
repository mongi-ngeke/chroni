  {
    "id": "table.Card",
    "label": "Create table \"Card\"",
    "summary": "Creates table \"Card\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "Card"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"Card\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"Card\""
        ],
        "expectation": {
          "expects": "absent",
          "object": "table \"Card\""
        }
      }
    ],
    "execute": [
      {
        "description": "create table \"Card\"",
        "sql": "CREATE TABLE \"public\".\"Card\" (\n  \"category\" text,\n  \"createdAt\" timestamptz(3) NOT NULL,\n  \"id\" text NOT NULL,\n  \"title\" text NOT NULL,\n  \"year\" int4 NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"Card\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_class\" AS \"c\" WHERE (\"c\".\"oid\" = to_regclass($1) AND (\"c\".\"relkind\" = $2 OR \"c\".\"relkind\" = $3))) AS \"result\"",
        "params": [
          "\"public\".\"Card\"",
          "r",
          "p"
        ],
        "expectation": {
          "expects": "present",
          "object": "table \"Card\""
        }
      }
    ]
  }
